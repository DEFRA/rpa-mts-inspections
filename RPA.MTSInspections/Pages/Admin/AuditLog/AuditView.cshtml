@page "/Admin/AuditView"
@model AuditViewModel

@{
    /**/

    ViewBag.Title = "AuditView";
}

@using X.PagedList.Mvc.Core;
@using X.PagedList;


<h2>Audit View</h2>

<h3>@Html.ViewBag.plantName</h3>

<form method="get">
    <p>
        @Html.DropDownList("schemeSelected", new SelectList(ViewBag.schemeList as List<SelectListItem>, "Value", "Text"))

        @Html.Hidden("SelectedValue")

        @Html.Hidden("plantId")

        <button class="btn btn-primary" style="position:static;" id="AuditViewFilter">Filter</button>

    </p>

    <input type="hidden" name="DropDownValue" id="hiddenFormElement" />
</form>

<table class="table">
    <tr>

        <th>
            @Html.DisplayNameFor(model => model.Audits[0].Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Audits[0].User)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Audits[0].Action)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Audits[0].PropertyName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Audits[0].Value)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Audits[0].NewValue)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.Audits)
    {
        <tr>



            <td>
                @item.Date.ToLocalTime()
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Action)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PropertyName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Value)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NewValue)
            </td>
            @Html.HiddenFor(modelItem => item.PlantId)
        </tr>
    }

</table>

<div class="float-left clear-left">
    @Html.PagedListPager(Model.Audits, page => Url.Page("/Admin/AuditLog/AuditView", new { plantId = (object)ViewBag.plantId, schemeSelected = (object)ViewBag.schemeSelected, page, pageSize = Model.Audits.PageSize }))
    Showing @(Model.Audits.TotalItemCount < Model.Audits.FirstItemOnPage ? 0 : Model.Audits.FirstItemOnPage) to @Model.Audits.LastItemOnPage of @Model.Audits.TotalItemCount Plants
</div>