@page "/Plant/Index"
@model IndexModel

@{
    ViewBag.Title = "Plant";
}

@using X.PagedList.Mvc.Core;
@using X.PagedList;

<h2>Plant List</h2>

<form method="get">
    <div>
        <div class="col-md-2">
            <input type="text" name="searchString" id="searchString" style="margin-bottom:10px" />
        </div>
        <div class="col-md-1" style="margin-bottom:10px">
            <button class="btn-primary" style="position:static" id="searchButton">Search</button>
        </div>

        <div class="col-md-1" style="margin-bottom:10px">
            <button type="button" class="btn-primary" style="position:static;" onclick="location.href='@Url.Page("/Plants/Index")'">Reset</button>
        </div>

        @*<div class="col-md-offset-11">
            <p><a asp-page="/Admin/Plants/Create">Add Plant</a></p>
        </div>*@
    </div>
</form>

<table class="table">
    <tr>
        <th style="border-top:none"></th>
        <th style="border-top:none"></th>
        <th style="border-top:none"></th>
        <th colspan="2" style="text-align:center; border:groove">BCC</th>
        <th colspan="2" style="text-align:center; border:groove">BLS</th>
        <th colspan="2" style="text-align:center; border:groove">PCG</th>
        <th colspan="2" style="text-align:center; border:groove">SCC</th>
    </tr>

    <tr>
        <th>@Html.DisplayNameFor(model => model.Plants[0].LicenceNo)</th>

        <th>@Html.DisplayNameFor(model => model.Plants[0].PlantName)</th>

        <th>@Html.DisplayNameFor(model => model.Plants[0].PostCode)</th>

        <th style="border-left:groove; text-align:center">Risk Score</th>

        <th style="border-right:groove; text-align:center">Update</th>

        <th style="text-align:center">Risk Score</th>

        <th style="border-right:groove; text-align:center">Update</th>

        <th style="text-align:center">Risk Score</th>

        <th style="border-right:groove; text-align:center">Update</th>

        <th style="text-align:center">Risk Score</th>

        <th style="border-right:groove; text-align:center">Update</th>
    </tr>

    @foreach (var item in Model.Plants)
    {
<tr>
    <td>@Html.DisplayFor(modelItem => item.LicenceNo)</td>

    <td>@Html.DisplayFor(modelItem => item.PlantName)</td>

    <td>@Html.DisplayFor(modelItem => item.PostCode)</td>

    <td style="border-left:groove; text-align:center">
        @if (item.BCC == true)
        {
            @item.RiskScore.Where(x => x.Scheme.Name == "BCC").Select(x => x.Score).FirstOrDefault()
        }
        else
        {
            @Html.Display("N/A")
        }
    </td>

    <td style="border-right:groove; text-align:center">
        @if (item.BCC == true)
        {
            <p><a asp-page="/Plants/Details" asp-route-id="@item.PlantId" asp-route-scheme="BCC">Edit</a></p>
        }
        else
        {
            @Html.Display("N/A")
        }
    </td>

    <td style="text-align:center">
        @if (item.BLS == true)
        {
            @item.RiskScore.Where(x => x.Scheme.Name == "BLS").Select(x => x.Score).FirstOrDefault()
        }
        else
        {
            @Html.Display("N/A")
        }

    </td>

    <td style="border-right:groove; text-align:center">
        @if (item.BLS == true)
        {

            <p><a asp-page="/Plants/Details" asp-route-id="@item.PlantId" asp-route-scheme="BLS">Edit</a></p>
        }
    </td>

    <td style="text-align:center">
        @if (item.PCG == true)
        {
            @item.RiskScore.Where(x => x.Scheme.Name == "PCG").Select(x => x.Score).FirstOrDefault()
        }
        else
        {
            @Html.Display("N/A")
        }

    </td>
    <td style="border-right:groove; text-align:center">
        @if (item.PCG == true)
        {
            <p><a asp-page="/Plants/Details" asp-route-id="@item.PlantId" asp-route-scheme="PCG">Edit</a></p>
        }
    </td>

    <td style="text-align:center">
        @if (item.SCC == true)
        {
            @item.RiskScore.Where(x => x.Scheme.Name == "SCC").Select(x => x.Score).FirstOrDefault()
        }
        else
        {
            @Html.Display("N/A")
        }

    </td>
    <td style="border-right:groove; text-align:center">
        @if (item.SCC == true)
        {
            <p><a asp-page="/Plants/Details" asp-route-id="@item.PlantId" asp-route-scheme="SCC">Edit</a></p>
        }
    </td>

    @Html.HiddenFor(modelItem => item.PlantId)
</tr>
    }
</table>

<div class="float-left clear-left">
    @Html.PagedListPager(Model.Plants, page => Url.Page("/Plants/Index", new { searchstring = (string)ViewBag.searchData, page, pageSize = Model.Plants.PageSize }))
    Showing @(Model.Plants.TotalItemCount < Model.Plants.FirstItemOnPage ? 0 : Model.Plants.FirstItemOnPage) to @Model.Plants.LastItemOnPage of @Model.Plants.TotalItemCount Plants
</div>