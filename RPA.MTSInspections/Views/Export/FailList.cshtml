@model List<RPA.MTSInspections.Models.ErrorLog>

@{
    ViewBag.Title = "Error Log";
}

<h2>Error List</h2>
<div class="col-md-offset-11">
    <p>@Html.ActionLink("Back", "Index", "Export")</p>
</div>

<table class="table">

    <tr>
        <th>@Html.DisplayNameFor(model => model[0].LicenceNo)</th>
        <th>@Html.DisplayNameFor(model => model[0].Scheme)</th>
        <th>@Html.DisplayNameFor(model => model[0].Error)</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.LicenceNo) </td>
            <td>@Html.DisplayFor(modelItem => item.Scheme) </td>
            <td>@Html.DisplayFor(modelItem => item.Error) </td>
        </tr>
    }
</table>
