@{
    ViewBag.Title = "Sign out";
}

<h2>Sign out</h2>
<p>Do you want to sign out of MTS Risk Analysis?</p>

<form asp-controller="Account" asp-action="SignOut" method="post">
    <button type="submit" class="btn btn-primary" style="position:static;">Sign out</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-default">Cancel</a>
</form>
