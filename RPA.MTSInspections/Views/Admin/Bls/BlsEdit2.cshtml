@model IEnumerable<RPA.MTSInspections.Models.Criteria>

@{
    ViewBag.Title = "BlsEdit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>BlsEdit</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Scheme.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Weighting)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Scheme.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Weighting)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.CriteriaId }) |
            @Html.ActionLink("Details", "Details", new { id=item.CriteriaId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.CriteriaId })
        </td>
    </tr>
}

</table>
