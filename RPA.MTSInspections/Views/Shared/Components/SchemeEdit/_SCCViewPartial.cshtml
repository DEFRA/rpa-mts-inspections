@model RPA.MTSInspections.ViewModels.SCCSchemeView

@using (Html.BeginForm("SCCSchemePost", "Scheme", FormMethod.Post, new { @id = ViewBag.PlantId }))
{
    @Html.AntiForgeryToken()

    <h2 align="center">@ViewBag.SchemeName Scheme Details</h2>

    if (User.IsInRole("MTS Risk Analysis: Basic Access") ||
        User.IsInRole("MTS Risk Analysis : General User – Support Team") ||
        User.IsInRole("MTS Risk Analysis : General User – Inspector") ||
        User.IsInRole("MTS Risk Analysis : Admin User"))
    {
        <div class="form-group row">
            @Html.LabelFor(model => model.Throughput, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("Throughput", null, new { @class = "form-control", tabindex = "1" })
                @Html.ValidationMessageFor(model => model.Throughput, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.OperatingHours, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("OperatingHours", null, new { @class = "form-control", tabindex = "11" })

                @Html.ValidationMessageFor(model => model.OperatingHours, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.SignIn, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("SignIn", null, new { @class = "form-control", tabindex = "2" })
                @Html.ValidationMessageFor(model => model.SignIn, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.Trimming, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("Trimming", null, new { @class = "form-control", tabindex = "12" })
                @Html.ValidationMessageFor(model => model.Trimming, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.SkinRemoval, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("SkinRemoval", null, new { @class = "form-control", tabindex = "3" })
                @Html.ValidationMessageFor(model => model.SkinRemoval, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.HeadRemoval, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("HeadRemoval", null, new { @class = "form-control", tabindex = "13" })
                @Html.ValidationMessageFor(model => model.HeadRemoval, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.FeetRemoval, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("FeetRemoval", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.FeetRemoval, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.CarcassDressing, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("CarcassDressing", null, new { @class = "form-control", tabindex = "14" })
                @Html.ValidationMessageFor(model => model.CarcassDressing, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.SchemeYear, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("SchemeYear", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.SchemeYear, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.FailedUnsatisfactory, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("FailedUnsatisfactory", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.FailedUnsatisfactory, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.FailedUnsatisfactoryInLast12Months, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("FailedUnsatisfactoryInLast12Months", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.FailedUnsatisfactoryInLast12Months, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.NearMissesInLast12Months, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("NearMissesInLast12Months", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.NearMissesInLast12Months, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group row">
            @Html.LabelFor(model => model.EnforcementNoticesIssuedLast12Months, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("EnforcementNoticesIssuedLast12Months", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.EnforcementNoticesIssuedLast12Months, "", new { @class = "text-danger" })
            </div>
            @Html.LabelFor(model => model.NumberPenaltyNoticesIssuedInLast12Months, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-sm-4">
                @Html.DropDownList("NumberPenaltyNoticesIssuedInLast12Months", null, new { @class = "form-control", tabindex = "4" })
                @Html.ValidationMessageFor(model => model.NumberPenaltyNoticesIssuedInLast12Months, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-8 col-md-10">
                <input type="submit" style="margin-bottom:10px" value="Save" class="btn btn-primary" />
            </div>
        </div>
    }

    @Html.Hidden("PlantId")

}

<script>
    $(function () {
        $(".date-picker").datepicker({
            changeMonth: true,
            changeYear: true,
            format: 'dd/mm/yy',
            autoclose: true
        });
    })
</script>
